<Window x:Class="AutoShutdownUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shutdown Otomatis" Height="295" Width="410"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Opacity="0">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0.0" To="1.0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>

        <!-- Template dasar semua tombol -->
        <ControlTemplate x:Key="BtnTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>

        <Style x:Key="BaseBtn" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template" Value="{StaticResource BtnTemplate}"/>
        </Style>

        <!-- Chip preset tunda -->
        <Style x:Key="ChipBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="#363945"/>
            <Setter Property="Foreground" Value="#ECEFF4"/>
            <Setter Property="Padding" Value="0,9"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#454959"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#3B82F6"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tombol stepper - dan + -->
        <Style x:Key="StepBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="#363945"/>
            <Setter Property="Foreground" Value="#ECEFF4"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#454959"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#3B82F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tombol aksi utama (Tunda custom) -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tombol darurat: batalkan shutdown -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="#3A2227"/>
            <Setter Property="Foreground" Value="#FCA5A5"/>
            <Setter Property="BorderBrush" Value="#F87171"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF4444"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tombol teks kecil (Atur sendiri / Kembali) -->
        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#7AA2F7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="8,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#A5C0FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox dengan highlight saat fokus -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CaretBrush" Value="#F3F4F6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="#2B2E38" CornerRadius="8"
                                BorderBrush="#3E4251" BorderThickness="1.5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5B6072"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#262830"
            CornerRadius="16"
            BorderBrush="#3B3E4B"
            BorderThickness="2"
            ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <StackPanel Grid.Row="0" Margin="22,18,22,0">
                <TextBlock Text="Timer Shutdown Berjalan"
                           FontSize="16" FontWeight="Bold" Foreground="#F3F4F6"/>
                <TextBlock x:Name="TxtTargetTime"
                           Text="Jadwal mati: 23:00:00"
                           FontSize="13" Foreground="#B4BAC6" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- 2. Countdown -->
            <StackPanel Grid.Row="1" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="0,4">
                <TextBlock x:Name="TxtSeconds" Text="60"
                           FontSize="54" FontWeight="Bold" Foreground="#6EE7B7"/>
                <TextBlock Text="detik lagi"
                           FontSize="14" FontWeight="Medium" Foreground="#9CA3AF"
                           VerticalAlignment="Bottom" Margin="8,0,0,12"/>
            </StackPanel>

            <!-- 3. Panel Tunda (tersembunyi default) -->
            <StackPanel Grid.Row="2" Margin="20,0,20,12">
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Tunda shutdown" FontSize="12" FontWeight="SemiBold"
                   Foreground="#9CA3AF" VerticalAlignment="Center"/>
                    <Button x:Name="BtnToggleCustom" Content="Atur sendiri"
                Style="{StaticResource LinkBtn}"
                HorizontalAlignment="Right"
                Click="BtnToggleCustom_Click"/>
                </Grid>

                <Grid Height="36">
                    <!-- Mode preset (default) -->
                    <UniformGrid x:Name="PresetRow" Columns="4" Margin="-3,0">
                        <Button Content="+5 mnt"  Tag="5"  Style="{StaticResource ChipBtn}" Margin="3,0" Click="BtnSnoozeTemplate_Click"/>
                        <Button Content="+15 mnt" Tag="15" Style="{StaticResource ChipBtn}" Margin="3,0" Click="BtnSnoozeTemplate_Click"/>
                        <Button Content="+30 mnt" Tag="30" Style="{StaticResource ChipBtn}" Margin="3,0" Click="BtnSnoozeTemplate_Click"/>
                        <Button Content="+1 jam"  Tag="60" Style="{StaticResource ChipBtn}" Margin="3,0" Click="BtnSnoozeTemplate_Click"/>
                    </UniformGrid>

                    <!-- Mode atur sendiri -->
                    <Grid x:Name="CustomRow" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="−" Style="{StaticResource StepBtn}" Click="BtnStepMinus_Click"/>

                        <TextBox Grid.Column="1" x:Name="TxtCustomMinutes"
                     Style="{StaticResource InputBox}"
                     Text="15" Width="56" Height="34" Margin="6,0"
                     MaxLength="3"
                     InputMethod.IsInputMethodEnabled="False"
                     DataObject.Pasting="TxtCustomMinutes_Pasting"
                     PreviewTextInput="TxtCustomMinutes_PreviewTextInput"
                     PreviewMouseLeftButtonDown="TxtCustomMinutes_PreviewMouseDown"
                     GotKeyboardFocus="TxtCustomMinutes_GotKeyboardFocus"
                     LostKeyboardFocus="TxtCustomMinutes_LostKeyboardFocus"
                     PreviewKeyDown="TxtCustomMinutes_PreviewKeyDown"
                     PreviewMouseWheel="TxtCustomMinutes_MouseWheel"
                     TextChanged="TxtCustomMinutes_TextChanged"/>

                        <Button Grid.Column="2" Content="+" Style="{StaticResource StepBtn}" Click="BtnStepPlus_Click"/>

                        <Button Grid.Column="3" x:Name="BtnCustomSnooze"
                    Content="Tunda 15 mnt"
                    Style="{StaticResource PrimaryBtn}"
                    Margin="8,0,0,0"
                    Click="BtnCustomSnooze_Click"/>
                    </Grid>
                </Grid>
            </StackPanel>

            <!-- 4. Dua aksi utama sejajar -->
            <Button Grid.Row="3"
                    Content="Batalkan Shutdown"
                    Style="{StaticResource DangerBtn}"
                    Height="40" Margin="20,0,20,12"
                    Click="BtnCancel_Click"/>

            <!-- 5. Progress bar -->
            <Border Grid.Row="4" x:Name="ProgressTrack"
                    Background="#1A1C22" CornerRadius="2"
                    Height="4" Margin="20,0,20,14">
                <Border x:Name="ProgressBarFill" Background="#6EE7B7"
                        CornerRadius="2" HorizontalAlignment="Left" Width="366"/>
            </Border>
        </Grid>
    </Border>
</Window>